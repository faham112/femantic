# Database
DATABASE_URL=postgresql://femantic:femantic_secret@localhost:5432/femantic

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Tracking
TRACK_RATE_LIMIT=60
BOT_SCORE_THRESHOLD=0.7

# Optional: Stripe (for Femantic Pro later)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
