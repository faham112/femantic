APP_PUBLIC_URL=https://analytics.globalcareerhub.org

DATABASE_URL=postgresql://femantic:femantic_secret@localhost:5432/femantic
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-this-to-a-very-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=admin@femantic.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Femantic Admin

# Empty = same-origin via nginx at analytics.globalcareerhub.org
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=https://analytics.globalcareerhub.org,http://analytics.globalcareerhub.org

TRACK_RATE_LIMIT=60
BOT_SCORE_THRESHOLD=0.7
