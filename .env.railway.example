# Copy values into Railway service Variables (not committed secrets)

# --- Backend service ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
JWT_SECRET=change-me-to-long-random-string-at-least-32-chars
