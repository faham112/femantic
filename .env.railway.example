CORS_ORIGINS=*
APP_PUBLIC_URL=https://YOUR-BACKEND.up.railway.app
DEBUG=false
TRACK_RATE_LIMIT=60
BOT_SCORE_THRESHOLD=0.7

# --- Frontend service ---
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.up.railway.app
